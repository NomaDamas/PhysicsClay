/vendor
/models
__pycache__/
*.pyc
*.egg-info/
/build/
/dist/
.pytest_cache/
.ruff_cache/

# secrets: keys live only in .env (SECURITY.md); certs/ holds the generated TLS key
.env
.env.*
!.env.example
certs/

